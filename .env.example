# Admin Auth
ADMIN_PASSWORD=your-secure-password

# LLM Providers
# Provider/engine config now lives in Settings (DB), not env.
# TEXT_PROVIDER, IMAGE_PROVIDER, VIDEO_PROVIDER, CONTENT_ENGINE, etc. are managed in the Settings UI.
GOOGLE_CLOUD_PROJECT_ID=  # project id owning GOOGLE_AI_API_KEY (e.g. gen-lang-client-XXXX), used for Cloud Console usage links

# AI provider API keys (GOOGLE_AI_API_KEY, HUGGINGFACE_API_KEY, POLLINATIONS_API_KEY)
# are managed in Settings → API Keys in the web UI.

# Instagram / Meta (from developers.facebook.com)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/instagram/callback

# Cron (protects /api/cron/* endpoints)
CRON_SECRET=your-cron-secret

# Higgsfield credentials (KEY_ID:KEY_SECRET from cloud.higgsfield.ai)
HIGGSFIELD_CREDENTIALS=
